{% extends "layouts/edit-link.njk" %}
{% from "macros/ui.njk" import field_error with context %}

{# FORM page of a public edit link: ONE field, for the Google Maps link. It always opens empty. Who this barcode is and
   whether Maps is already set are on the activation page (/e/{token}); saving returns there. #}

{% block scripts %}<script src="/assets/js/barcodes.js?v={{ assetVersion }}" defer></script>{% endblock %}

{% block editContent %}
<p class="rv-eyebrow">Aktivasi · Langkah 2 dari 3</p>
<h1 class="edit-page__title">Masukkan Maps</h1>
<p class="edit-page__sub">Tempel link lokasi Anda dari Google Maps. QR Code lalu mengarah ke halaman ulasan Google untuk lokasi itu, tanpa perlu dicetak ulang.</p>

<div class="card edit-card">
  <div class="edit-card__ref">
    <div class="edit-card__refmeta">
      <span class="edit-card__code">{{ barcode.code }}</span>
      <span class="edit-card__name">{{ barcode.name }}</span>
    </div>
    <a class="edit-back" href="/e/{{ token }}">{{ icon('arrow-left', 14) }} Kembali</a>
  </div>

  <div class="edit-card__body">
    {% if errors and (errors | length) %}
    <div class="alert alert--danger" role="alert">{{ icon('warning-circle', 20) }}<div>Maps belum bisa disimpan. Periksa isian yang ditandai di bawah.</div></div>
    {% endif %}

    <form class="edit-form" method="post" action="/e/{{ token }}/edit" novalidate data-single-submit>
      <div class="field">
        <label class="field__label" for="maps_link">Link Google Maps</label>
        <input class="input input--mono{% if errors.maps_link %} is-invalid{% endif %}" id="maps_link" name="maps_link" type="text" value="{{ form.maps_link }}" placeholder="https://maps.app.goo.gl/..." inputmode="url" autocomplete="off" autocapitalize="none" spellcheck="false"{% if not errors | length %} autofocus{% endif %} aria-describedby="maps_link-hint maps_link-error"{% if errors.maps_link %} aria-invalid="true"{% endif %}>
        <p class="field__hint" id="maps_link-hint">Buka lokasinya di Google Maps, pilih <strong>Bagikan</strong>, lalu <strong>Salin link</strong>. Link pendek (maps.app.goo.gl) dan link panjang dari google.com/maps sama-sama bisa.</p>
        {{ field_error(errors, 'maps_link') }}
      </div>

      <div class="edit-actions">
        <button class="btn btn--primary btn--lg" type="submit" data-busy-text="Memeriksa link...">{{ icon('check', 18) }} Simpan</button>
        <a class="btn btn--ghost btn--lg" href="/e/{{ token }}">Batal</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
