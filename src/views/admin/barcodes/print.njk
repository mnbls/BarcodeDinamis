{% extends "layouts/base.njk" %}

{% block styles %}
<link rel="stylesheet" href="/assets/css/print.css?v={{ assetVersion }}">
{% if barcode.target_type == 'maps_review' or not barcode.target_url %}<link rel="preload" href="/assets/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>{% endif %}
{% endblock %}
{% block bodyClass %}print-page{% endblock %}
{% block bodyAttrs %}data-autoprint="{{ '1' if auto else '0' }}"{% endblock %}

{% block body %}
{# Two things can be printed. The plain label (QR, name, code) suits every barcode. The review card is the printed twin of the
   card on the activation page (/e/{token}): it is offered for Google Maps review barcodes and for barcodes still waiting for a
   destination, and nowhere else, because its wording ("Pindai untuk menulis ulasan di Google") is only true for those. Both are
   drawn from the same data and the same QR file. Which one shows, and the card's size and colour, are decided by the radios
   alone (print.css): no script. The card never shows the secret edit link. #}
{% set cardAvailable = barcode.target_type == 'maps_review' or not barcode.target_url %}
{% set showCard = cardAvailable and layout == 'card' %}
<header class="print-toolbar">
  <span class="print-toolbar__title">Cetak {{ barcode.code }}</span>

  {% if cardAvailable %}
  <div class="print-toolbar__group">
    <span id="layout-label">Bentuk</span>
    <div class="segmented" role="radiogroup" aria-labelledby="layout-label">
      <label><input type="radio" name="layout" value="label"{% if not showCard %} checked{% endif %}><span>Label QR</span></label>
      <label><input type="radio" name="layout" value="card"{% if showCard %} checked{% endif %}><span>Kartu review</span></label>
    </div>
  </div>
  {% endif %}

  <div class="print-toolbar__group" data-only="label">
    <span id="size-label">Ukuran QR</span>
    <div class="segmented" role="radiogroup" aria-labelledby="size-label">
      <label><input type="radio" name="size" value="3.5cm"><span>Kecil · 3,5 cm</span></label>
      <label><input type="radio" name="size" value="6cm" checked><span>Sedang · 6 cm</span></label>
      <label><input type="radio" name="size" value="9cm"><span>Besar · 9 cm</span></label>
    </div>
  </div>

  {% if cardAvailable %}
  <div class="print-toolbar__group" data-only="card">
    <span id="card-size-label">Ukuran kartu</span>
    <div class="segmented" role="radiogroup" aria-labelledby="card-size-label">
      <label><input type="radio" name="card-size" value="standard" checked><span>Standar · 8,56 × 5,4 cm</span></label>
      <label><input type="radio" name="card-size" value="large"><span>Besar · 14,5 × 9,2 cm</span></label>
    </div>
  </div>
  <div class="print-toolbar__group" data-only="card">
    <span id="card-theme-label">Warna</span>
    <div class="segmented" role="radiogroup" aria-labelledby="card-theme-label">
      <label><input type="radio" name="card-theme" value="dark" checked><span>Gelap</span></label>
      <label><input type="radio" name="card-theme" value="light"><span>Terang</span></label>
    </div>
  </div>
  {% endif %}

  <button class="btn btn--primary" type="button" data-print>{{ icon('printer', 18) }} Cetak</button>
  <a class="btn btn--ghost" href="/admin/barcodes/{{ barcode.code }}">Kembali</a>
</header>

<main class="sheet" id="main" tabindex="-1">
  <article class="label" data-label>
    <div class="label__qr"><img src="/admin/barcodes/{{ barcode.code }}/qr.svg" alt="QR Code untuk {{ barcode.code }}"></div>
    <div class="label__name">{{ barcode.name }}</div>
    <div class="label__code">{{ barcode.code }}</div>
    <div class="label__url">{{ redirectUrl }}</div>
  </article>

  {% if cardAvailable %}
  <section class="pcards" aria-label="Kartu review {{ barcode.code }}">
    <figure class="pcard-wrap">
      <div class="pcard pcard--front" role="group" aria-label="Kartu, sisi depan">
        <div class="pcard__top">
          <span class="pcard__brand"><span class="pcard__mark">{{ icon('star-fill', 12) }}</span><span class="pcard__brand-name">{{ app.brand }}</span></span>
          <span class="pcard__stars" aria-hidden="true">{% for n in range(0, 5) %}{{ icon('star-fill', 16) }}{% endfor %}</span>
        </div>
        <div class="pcard__main">
          <div class="pcard__pitch">
            <p class="pcard__headline">Bagikan pengalaman Anda</p>
            <p class="pcard__hint">Pindai untuk menulis ulasan di Google</p>
          </div>
          <div class="pcard__qr"><img src="/admin/barcodes/{{ barcode.code }}/qr.svg" alt="QR Code untuk {{ barcode.code }}"></div>
        </div>
        <div class="pcard__foot">
          <span class="pcard__name">{{ barcode.name }}</span>
          <span class="pcard__code">{{ barcode.code }}</span>
        </div>
      </div>
      <figcaption class="pcard-cap">Depan</figcaption>
    </figure>

    <figure class="pcard-wrap">
      <div class="pcard pcard--back" role="group" aria-label="Kartu, sisi belakang">
        <div class="pcard__top">
          <span class="pcard__brand"><span class="pcard__mark">{{ icon('star-fill', 12) }}</span><span class="pcard__brand-name">{{ app.brand }}</span></span>
          <span class="pcard__stars" aria-hidden="true">{% for n in range(0, 5) %}{{ icon('star-fill', 16) }}{% endfor %}</span>
        </div>
        <div class="pcard__how">
          <p class="pcard__title">Tulis ulasan dalam tiga langkah</p>
          <ol class="pcard__steps">
            <li class="pcard__step"><span class="pcard__num" aria-hidden="true">1</span>Buka kamera ponsel</li>
            <li class="pcard__step"><span class="pcard__num" aria-hidden="true">2</span>Arahkan ke kode QR di sisi depan</li>
            <li class="pcard__step"><span class="pcard__num" aria-hidden="true">3</span>Ketuk tautan, lalu tulis ulasan Anda</li>
          </ol>
        </div>
        <div class="pcard__foot pcard__foot--note">
          <span class="pcard__fallback">Atau buka <b>{{ redirectUrl | displayUrl }}</b></span>
        </div>
      </div>
      <figcaption class="pcard-cap">Belakang</figcaption>
    </figure>
  </section>
  {% endif %}
</main>
<script src="/assets/js/barcodes.js?v={{ assetVersion }}" defer></script>
{% endblock %}
