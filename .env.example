# =============================================================================
# Dynamic Barcode Management System - contoh konfigurasi
# Salin menjadi ".env" lalu sesuaikan:  cp .env.example .env
# JANGAN commit file .env dan jangan pernah membagikan isinya.
# =============================================================================

# --- Aplikasi ----------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# URL publik aplikasi. Alamat ini DITANAM di dalam QR Code (https://domain/b/BR-000001).
# Tentukan domain final SEBELUM mencetak QR. Jika domain berubah, QR yang sudah
# tercetak hanya tetap berfungsi bila domain lama masih mengarah ke aplikasi ini.
APP_URL=https://barcode.example.com
APP_NAME=Dynamic Barcode

# Zona waktu untuk tampilan tanggal dan "scan hari ini" (nama IANA).
APP_TIMEZONE=Asia/Jakarta

# --- Database (PostgreSQL 13+) -------------------------------------------------
DATABASE_URL=postgres://barcode_app:GANTI_PASSWORD@localhost:5432/barcode_dinamis
# false | true (verifikasi sertifikat) | no-verify (SSL tanpa verifikasi, mis. sertifikat self-signed)
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=20000

# true = jalankan migration database yang tertunda setiap aplikasi start (praktis untuk Docker/PaaS).
# Di server biasa cukup jalankan "npm run migrate" saat deploy.
AUTO_MIGRATE=false

# Hanya untuk "npm run db:create" (membuat role + database). Boleh dikosongkan setelah selesai.
# ADMIN_DATABASE_URL=postgres://postgres:PASSWORD_SUPERUSER@localhost:5432/postgres

# Database terpisah untuk "npm test" (isinya DIHAPUS setiap tes berjalan!).
# TEST_DATABASE_URL=postgres://barcode_app:GANTI_PASSWORD@localhost:5432/barcode_dinamis_test

# --- Keamanan ------------------------------------------------------------------
# Wajib di production, minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=bdms.sid
SESSION_TTL_HOURS=8
# auto = "Secure" bila production dan APP_URL memakai https
COOKIE_SECURE=auto
BCRYPT_ROUNDS=12

# Di belakang reverse proxy (Nginx/Cloudflare/PaaS), isi jumlah proxy yang dipercaya (biasanya 1)
# agar IP asli pengunjung terbaca untuk statistik dan rate limit. 0 = tidak ada proxy.
TRUST_PROXY=0

# Batas percobaan login per IP dalam satu jendela waktu.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
# Batas permintaan per menit per IP untuk halaman login (mencegah bot menumpuk session).
PUBLIC_PAGE_RATE_LIMIT_MAX=120

# Link edit tanpa login (/e/{token}): siapa pun yang memegang link bisa mengubah TUJUAN satu barcode.
# Tiga batas: semua permintaan per menit per IP; link yang TIDAK dikenal per 10 menit per IP (menghambat
# penebakan); dan penyimpanan per link per jam (link yang bocor tidak bisa membanjiri riwayat).
EDIT_LINK_RATE_LIMIT_MAX=60
EDIT_LINK_INVALID_RATE_LIMIT_MAX=10
EDIT_LINK_SAVE_RATE_LIMIT_MAX=30

# --- Barcode -------------------------------------------------------------------
# sequential -> BR-000001, BR-000002, ...   (mudah dibaca, urut)
# random     -> BR-7K3M9QXT                 (tidak bisa ditebak/di-enumerasi)
CODE_MODE=sequential
CODE_PREFIX=BR

# Error correction QR: L(7%) M(15%) Q(25%) H(30%). Q cocok untuk cetak.
QR_ERROR_CORRECTION=Q
QR_MARGIN=4
QR_PNG_SIZE=1024

# --- Endpoint redirect /b/{kode} ---------------------------------------------------
# Cache lookup di memori (ms). 0 = nonaktif (selalu baca DB, perubahan langsung berlaku).
# Bila diisi, perubahan dari proses lain baru terlihat setelah TTL habis.
REDIRECT_CACHE_TTL_MS=0
REDIRECT_RATE_LIMIT_MAX=600
REDIRECT_RATE_LIMIT_WINDOW_SEC=60
# Batas khusus kode yang TIDAK ADA (menghambat penebakan kode).
REDIRECT_404_RATE_LIMIT_MAX=30
REDIRECT_404_RATE_LIMIT_WINDOW_SEC=60

# Privasi: true = simpan IP pengunjung dalam bentuk dianonimkan (oktet terakhir dinolkan).
IP_ANONYMIZE=false

# --- Import CSV ----------------------------------------------------------------
IMPORT_MAX_ROWS=20000
IMPORT_MAX_UPLOAD_MB=5

# --- Storage & logging -----------------------------------------------------------
STORAGE_DIR=storage
LOG_LEVEL=info
# true = tulis log JSON ke storage/logs/app.log (selain stdout)
LOG_TO_FILE=true

# --- Akun admin awal ("npm run seed") -----------------------------------------------
# Jika SEED_ADMIN_PASSWORD kosong, password acak dibuat dan ditampilkan SEKALI di terminal.
# Nilai yang mengandung # atau spasi WAJIB diberi tanda kutip, mis. SEED_ADMIN_PASSWORD="Rahasia#123"
# (tanpa kutip, karakter # dianggap awal komentar dan sisanya terpotong).
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@barcode.example.com
SEED_ADMIN_PASSWORD=
