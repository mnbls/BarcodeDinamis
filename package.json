  "description": "Dynamic Barcode Management System: QR Code dinamis yang tujuannya bisa diubah kapan saja tanpa mencetak ulang.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/server.js",
