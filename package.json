    "migrate:status": "node scripts/migrate.js status",
    "db:create": "node scripts/create-database.js",
    "db:reset": "node scripts/migrate.js fresh",
    "db:backup": "node scripts/backup-db.js",
    "seed": "node scripts/seed.js",
    "admin:create": "node scripts/create-admin.js",
    "admin:reset": "node scripts/reset-password.js",
